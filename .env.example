# 仅桌面主进程读取。请在本机复制为 .env，不要把真实密钥发送到聊天或仓库。
# MODEL_PROVIDER=zhida时使用同一知乎Access Secret；OpenAI配置保留但不发送。
MODEL_PROVIDER=zhida
ZHIDA_MODEL=zhida-fast-1p5
MODEL_API_KEY=
# 兼容 Chat Completions 的 HTTPS 根地址，可包含 /v1，或填完整 /chat/completions。
MODEL_BASE_URL=https://api.openai.com/v1
# 填写你在所选服务中实际有权限使用的模型 ID。
MODEL_NAME=
# 服务支持哪个长度参数就填写哪个：max_tokens / max_completion_tokens / none。
MODEL_TOKEN_PARAMETER=max_tokens
# 仅当所选模型支持 JSON object response_format 时开启。
MODEL_JSON_MODE=off
MODEL_TIMEOUT_MS=45000

# 知乎官方接口：使用赛事/开放平台发放的access_secret，与OpenAI密钥不同。
SEARCH_PROVIDER=zhihu
ZHIHU_ACCESS_SECRET=
# 只有显式切换到brave时使用SEARCH_API_KEY；bing-rss保留为实验选项。
SEARCH_API_KEY=

# 聊天默认知乎直答，使用 ZHIHU_ACCESS_SECRET 和 ZHIDA_MODEL。
# 可选备用模型 zhida-thinking-1p5。也可显式选择 existing、ollama 或 llama.cpp。
CHAT_PROVIDER=zhida
# CHAT_MODEL 和 CHAT_BASE_URL 仅用于显式选择的本机服务。
CHAT_MODEL=
CHAT_BASE_URL=
CHAT_CONTEXT_TOKENS=4096
CHAT_REPLY_TOKENS=384
CHAT_TIMEOUT_MS=90000
